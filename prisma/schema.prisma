  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShipmentReceivedStatus {
  PENDING
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  DISCREPANCY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
